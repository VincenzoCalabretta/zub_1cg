"""Board artifacts for the Avnet AES-ZUB-1CG (Zynq UltraScale+ ZU1CG) and integrity checks.

  design_1_wrapper.bit  — PL bitstream built from //vivado_workspace originals:
                          the eth-loopback-capable design (AXI GPIO at 0xA0000000,
                          GEM2 tapped for internal-loopback tests).
  generated/psu_init.tcl — local-only PS init generated from the pinned Avnet
                           board preset by //sdk/boards/zub_1cg:generate_psu_init.

The bitstream remains a noticed binary artifact.  The source-form PS init is
never a Bazel source or release artifact.
"""

load("@rules_rust//rust:defs.bzl", "rust_test")
load(":publication_guard.bzl", "reject_restricted_sources")

package(default_visibility = ["//visibility:public"])

reject_restricted_sources(glob(
    ["psu_init.tcl"],
    allow_empty = True,
))

filegroup(
    name = "bitstream",
    srcs = ["design_1_wrapper.bit"],
)

filegroup(
    name = "avnet_bdf",
    srcs = ["@avnet_bdf//:zub1cg_1_2"],
)

filegroup(
    name = "artifacts_manifest",
    srcs = ["artifacts.json"],
)

rust_test(
    name = "artifact_integrity_test",
    srcs = ["artifact_integrity_test.rs"],
    data = [
        ":artifacts_manifest",
        ":bitstream",
    ],
    deps = ["//tooling/elf_check:elf_check_lib"],
)

sh_binary(
    name = "generate_psu_init",
    srcs = ["generate_psu_init.sh"],
    data = [
        "board_preset.tcl",
        "create_ps_handoff.tcl",
        "export_psu_init.tcl",
        ":avnet_bdf",
    ],
    tags = [
        "local",
        "manual",
        "no-remote",
        "requires-vivado",
        "requires-xsct",
    ],
)

exports_files([
    "board_preset.tcl",
    "export_psu_init.tcl",
    "publication_guard.bzl",
])
