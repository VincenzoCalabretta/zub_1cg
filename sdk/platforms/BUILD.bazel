"""Platform definitions for the AES-ZUB-1CG (Zynq UltraScale+ ZU1CG)."""

package(default_visibility = ["//visibility:public"])

# Stock @platforms//cpu:armv7 doesn't distinguish the R-profile (ARM-state)
# and M-profile (Thumb-2-only) cores that both live under arm_none_eabi
# toolchains here, so rpu_r5_0 and pl_m3 would otherwise be ambiguous
# toolchain-resolution targets. This constraint disambiguates them.
constraint_setting(name = "arm_profile")

constraint_value(
    name = "cortex_r5",
    constraint_setting = ":arm_profile",
)

constraint_value(
    name = "cortex_m3",
    constraint_setting = ":arm_profile",
)

# Host — runs Bazel, tests, and drives JTAG.
platform(
    name = "host",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

# Application Processing Unit — Cortex-A53 (APU0), bare-metal.
platform(
    name = "apu_a53",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:aarch64",
    ],
)

# Real-time Processing Unit — Cortex-R5F core 0 (RPU0), bare-metal.
platform(
    name = "rpu_r5_0",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:armv7",
        ":cortex_r5",
    ],
)

# PL-hosted Cortex-M3 (Arm DesignStart FPGA edition) — Orbtrace's on-chip
# CoreSight trace source / SW-DP debug target, bare-metal.
platform(
    name = "pl_m3",
    constraint_values = [
        "@platforms//os:none",
        "@platforms//cpu:armv7",
        ":cortex_m3",
    ],
)
