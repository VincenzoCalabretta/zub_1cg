"""Bare-metal BSP smoke test for AES-ZUB Cortex-R5F (no ThreadX)."""

cc_binary(
    name = "bsp_test",
    srcs = ["main.c"],
    additional_linker_inputs = ["//board/rpu:linker_script"],
    copts = [
        "-mcpu=cortex-r5",
        "-mfpu=vfpv3-d16",
        "-mfloat-abi=hard",
        "-marm",
        "-ffreestanding",
        "-fno-builtin",
    ],
    linkopts = [
        "-T$(location //board/rpu:linker_script)",
        "-nostartfiles",
        "--specs=nano.specs",
        "--specs=nosys.specs",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//board:test_proto",
        "//board/rpu:bsp_bare",
    ],
)
