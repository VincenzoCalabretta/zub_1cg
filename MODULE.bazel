"""zub_1cg — mainline bare-metal + RTOS project for the Avnet AES-ZUB-1CG board.

Targets (added progressively as phases land):
  //applications/apu/...  — Cortex-A53 applications.
  //applications/rpu/...  — Cortex-R5F applications.
  //tests/...             — host-side integration tests driven by //tooling/zub_ctl.

Cross toolchains are registered transitively from //sdk/toolchains/....
"""

module(
    name = "zub_1cg",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.1.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_rust", version = "0.62.0")

# ── Rust toolchain (host-side tools) ──────────────────────────────────────────
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2021",
    versions = ["1.86.0"],
)
use_repo(rust, "rust_linux_x86_64__x86_64-unknown-linux-gnu__stable_tools", "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

# ── Rust cross toolchain (aarch64 bare-metal, APU A53 no_std) ─────────────────
# aarch64-unknown-none isn't in rules_rust 0.62.0's supported-triple table, so
# it can't be added via rust.toolchain(extra_target_triples = ...). Vendor the
# official rust-std component directly; //sdk/toolchains/aarch64_unknown_none
# wires it into a manual rust_toolchain alongside the host rustc above.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "rust_std_aarch64_unknown_none",
    build_file = "//sdk/toolchains/aarch64_unknown_none:rust_std.BUILD",
    sha256 = "99e9c7715b354cf145d9eb839791609acf058b6009449ba3a25c2b02159c53b7",
    strip_prefix = "rust-std-1.86.0-aarch64-unknown-none/rust-std-aarch64-unknown-none",
    url = "https://static.rust-lang.org/dist/rust-std-1.86.0-aarch64-unknown-none.tar.xz",
)

# Official Avnet ZUBoard board-definition files.  These Apache-2.0 sources
# contain the PS preset used to regenerate DDR/MIO initialization with a
# locally licensed Vivado/Vitis installation; generated psu_init.tcl output is
# deliberately not fetched or stored in this repository.
http_archive(
    name = "avnet_bdf",
    build_file_content = """
package(default_visibility = ["//visibility:public"])
filegroup(
    name = "zub1cg_1_2",
    srcs = glob(["zub1cg/1.2/**"]),
)
""",
    sha256 = "c9b75959167876426d4fc074cd408c8cb4176a8a15a37373ef1e217be508dea2",
    strip_prefix = "bdf-e9723b55a68b106fb4cdb645974d096cd3594a2a",
    type = "tar.gz",
    url = "https://codeload.github.com/Avnet/bdf/tar.gz/e9723b55a68b106fb4cdb645974d096cd3594a2a",
)

register_toolchains("//sdk/toolchains/aarch64_unknown_none:aarch64_unknown_none_toolchain")

# Rust crates for host-side tools. Each crate repository is generated by
# crate_universe from its checked-in Cargo manifest and lockfile; Cargo never
# produces an in-repository binary.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "zub_ctl_crates",
    cargo_lockfile = "//tooling/zub_ctl:Cargo.lock",
    manifests = ["//tooling/zub_ctl:Cargo.toml"],
)
use_repo(crate, "zub_ctl_crates")

crate.from_cargo(
    name = "docs_crates",
    cargo_lockfile = "//internal/docs_tool:Cargo.lock",
    manifests = ["//internal/docs_tool:Cargo.toml"],
)
use_repo(crate, "docs_crates")

crate.from_cargo(
    name = "elf_check_crates",
    cargo_lockfile = "//tooling/elf_check:Cargo.lock",
    manifests = ["//tooling/elf_check:Cargo.toml"],
)
use_repo(crate, "elf_check_crates")

crate.from_cargo(
    name = "pm_decode_crates",
    cargo_lockfile = "//tooling/pm_decode:Cargo.lock",
    manifests = ["//tooling/pm_decode:Cargo.toml"],
)
use_repo(crate, "pm_decode_crates")

# ── Env-based cross-toolchain capture ─────────────────────────────────────────
# The Nix shellHook exports ARM_GCC_BIN and AARCH64_GCC_BIN; these repository
# rules read them at fetch time and generate defs.bzl with pinned Nix-store
# paths. Consumed by //sdk/toolchains/*/config.bzl.
arm_gcc_ext = use_extension(
    "//sdk/toolchains/arm_none_eabi:env_ext.bzl",
    "arm_gcc_config_ext",
)
use_repo(arm_gcc_ext, "arm_gcc_config")

arm_gcc_m3_ext = use_extension(
    "//sdk/toolchains/arm_none_eabi_m3:env_ext.bzl",
    "arm_gcc_config_m3_ext",
)
use_repo(arm_gcc_m3_ext, "arm_gcc_config_m3")

aarch64_gcc_ext = use_extension(
    "//sdk/toolchains/aarch64_none_elf:env_ext.bzl",
    "aarch64_gcc_config_ext",
)
use_repo(aarch64_gcc_ext, "aarch64_gcc_config")

register_toolchains(
    "//sdk/toolchains/arm_none_eabi:arm_none_eabi_toolchain",
    "//sdk/toolchains/arm_none_eabi_m3:arm_none_eabi_m3_toolchain",
    "//sdk/toolchains/aarch64_none_elf:aarch64_none_elf_toolchain",
)

sdk_tools = use_extension("//sdk/toolchains:tools_ext.bzl", "tools_ext")
use_repo(sdk_tools, "zub_cross_tools", "zub_host_tools")

# ── Third-party sources (fetched by extensions.bzl) ───────────────────────────
threadx_ext = use_extension("//third_party:extensions.bzl", "threadx_extension")
use_repo(threadx_ext, "threadx")

filex_ext = use_extension("//third_party:extensions.bzl", "filex_extension")
use_repo(filex_ext, "filex")

netxduo_ext = use_extension("//third_party:extensions.bzl", "netxduo_extension")
use_repo(netxduo_ext, "netxduo")
