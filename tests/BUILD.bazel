    name = "apu_blink_elf_test",
    expected_entry = "0x0",
    expected_machine = "aarch64",
    expected_memory_range = "0x0:0x80000000",
    firmware = "//apps/apu/blink:blink.elf",
    firmware_platform = "//platforms:apu_a53",
    required_symbols = ["_vector_table"],
)

