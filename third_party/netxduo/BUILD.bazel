"""Eclipse NetX Duo — dual-stack TCP/IP for ThreadX bare-metal targets.

Downloaded and injected by netxduo_extension in extensions.bzl.
Paths are relative to the NetX Duo repo root.

Only the core IP stack (nx_*/nxd_*/nxe_* in common/src) and the cortex_a7/gnu
port are compiled here.  NetX Duo ships no cortex_a53 port; cortex_a7/gnu is
the closest AArch32/AArch64-compatible GNU port and nx_port.h is pure C
defines. Protocol add-ons (HTTP, FTP, MQTT, TLS, etc.) in addons/ are
excluded.

`nxe_*.c` are the public API's error-checking wrapper definitions
(`_nxe_ip_create` etc.) — separate translation units from their `_nx_*`
implementations, unconditionally compiled upstream regardless of whether a
consumer defines NX_DISABLE_ERROR_CHECKING. `nx_*.c` alone (matching neither
`nxd_` nor `nxe_`) omits all 132 of them.
"""

cc_library(
    name = "netxduo",
    srcs = glob(
        [
            "common/src/nx_*.c",
            "common/src/nxd_*.c",
            "common/src/nxe_*.c",
        ],
    ),
    hdrs = glob([
        "common/inc/*.h",
        "ports/cortex_a7/gnu/inc/*.h",
    ]),
    # These are public defines because both features add fields to NetX
    # packet/socket/interface structs and therefore must be identical in
    # NetX and every driver/application that includes nx_api.h. Interface
    # capabilities let GEM advertise checksum offload. Window scaling is
    # required for the host's receive window to exceed 65,535 bytes on the
    # high-throughput trace connection.
    defines = [
        "NX_ENABLE_INTERFACE_CAPABILITY",
        "NX_ENABLE_TCP_WINDOW_SCALING",
    ],
    includes = [
        "common/inc",
        "ports/cortex_a7/gnu/inc",
    ],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:aarch64",
    ],
    visibility = ["//visibility:public"],
    deps = ["@threadx//:threadx_a53"],
)
