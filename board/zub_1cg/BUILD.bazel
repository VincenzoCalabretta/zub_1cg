"""Board artifacts for the Avnet AES-ZUB-1CG (Zynq UltraScale+ ZU1CG).

  design_1_wrapper.bit  — PL bitstream built from //vivado_workspace originals:
                          the eth-loopback-capable design (AXI GPIO at 0xA0000000,
                          GEM2 tapped for internal-loopback tests).
  psu_init.tcl          — PSU init (clocks, MIO, DDR) generated by Vitis from
                          the .xsa hardware handoff; sourced by xsct at flash time.

Both artifacts are opaque blobs to Bazel — regenerated in Vitis/Vivado, not
here. See README.md § "Regenerating board artifacts" for the procedure.
"""

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "bitstream",
    srcs = ["design_1_wrapper.bit"],
)

filegroup(
    name = "psu_init",
    srcs = ["psu_init.tcl"],
)

filegroup(
    name = "artifacts_manifest",
    srcs = ["artifacts.json"],
)
