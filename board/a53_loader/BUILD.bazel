"""A53 loader shim — a tiny AArch64 ELF that copies an embedded R5 image into
TCM and releases R5-0 out of module reset, enabling SD-card boot without FSBL.

Individual source files are exported so //scripts/flash can reference them
directly in genrule commands.  See //scripts/flash:boot_bin for the complete
BOOT.BIN build chain.
"""

package(default_visibility = ["//visibility:public"])

exports_files([
    "main.c",
    "memory.lds",
    "startup.S",
])

filegroup(
    name = "sources",
    srcs = [
        "main.c",
        "startup.S",
    ],
)

filegroup(
    name = "linker_script",
    srcs = ["memory.lds"],
)
