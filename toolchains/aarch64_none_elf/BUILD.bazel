"""aarch64-none-elf toolchain for Cortex-A53 (APU) bare-metal."""

load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load(":config.bzl", "aarch64_none_elf_toolchain_config")

aarch64_none_elf_toolchain_config(name = "aarch64_none_elf_config")

filegroup(name = "empty")

cc_toolchain(
    name = "aarch64_none_elf_cc_toolchain",
    toolchain_config = ":aarch64_none_elf_config",
    all_files        = ":empty",
    ar_files         = ":empty",
    compiler_files   = ":empty",
    dwp_files        = ":empty",
    linker_files     = ":empty",
    objcopy_files    = ":empty",
    strip_files      = ":empty",
)

toolchain(
    name = "aarch64_none_elf_toolchain",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:none",
        "@platforms//cpu:aarch64",
    ],
    toolchain      = ":aarch64_none_elf_cc_toolchain",
    toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
)
