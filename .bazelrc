# ── Bzlmod ────────────────────────────────────────────────────────────────────
common --enable_bzlmod

# ── Nix devShell integration ──────────────────────────────────────────────────
# The Nix devShell exports ARM_GCC_BIN and AARCH64_GCC_BIN pointing to Nix-store
# compilers. Passing them (and PATH) into every Bazel action means no
# host-system tools are ever used during the build. sandbox_add_mount_pair=/nix
# makes the Nix store accessible inside the Linux sandbox.
build --action_env=ARM_GCC_BIN
build --action_env=AARCH64_GCC_BIN
build --action_env=PATH
# libudev is needed by the serialport crate; PKG_CONFIG_PATH is exported by the
# Nix devShell and points at systemdMinimal's pkgconfig dir.
build --action_env=PKG_CONFIG_PATH
build --sandbox_add_mount_pair=/nix

# ── Per-target-core configs ───────────────────────────────────────────────────
build:host --platforms=//sdk/platforms:host
test:host  --platforms=//sdk/platforms:host

build:apu --platforms=//sdk/platforms:apu_a53
build:rpu --platforms=//sdk/platforms:rpu_r5_0

# Bare-metal compile defaults for the cross builds.
build:apu --copt=-ffreestanding
build:apu --copt=-fno-builtin

build:rpu --copt=-ffreestanding
build:rpu --copt=-fno-builtin
build:rpu --linkopt=-nostartfiles

# ── On-board hardware test mode ──────────────────────────────────────────────
# Use --config=onboard together with --config=host when running tests that
# access physical hardware (JTAG cable, /dev/ttyUSB*).
# --spawn_strategy=local disables the Linux sandbox so tests can open /dev/*.
# Example:
#   bazel build --config=apu //apps/apu/blink:blink.elf
#   bazel test --config=host --config=onboard //tests:apu_blink_test
test:onboard --spawn_strategy=local
test:onboard --test_output=streamed
test:onboard --test_env=ZUB1CG_PSINIT

# ── Ergonomics ────────────────────────────────────────────────────────────────
build --verbose_failures
build --sandbox_default_allow_network=false
