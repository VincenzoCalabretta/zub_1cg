"""Firmware packaging + on-target flashing for AES-ZUB.

Bazel BOOT.BIN build chain (all tagged manual + local — run explicitly):
  //scripts/flash:boot_bin       — BOOT.BIN: R5 firmware embedded in A53 loader.
                                   Requires arm-none-eabi-objcopy, aarch64-none-elf-gcc,
                                   and bootgen in PATH (Nix devShell + Xilinx Vitis).
                                   Build: bazel build //scripts/flash:boot_bin

JTAG programming (requires Vitis xsct):
  //scripts/flash:xsct_jtag_flash — Flash an A53 ELF via xsct over JTAG.

SD-card programming (uses the legacy shell script):
  //scripts/flash:build_boot_a53 — Wrapper that also handles SD-card copy.
"""

load(":rules.bzl", "r5_firmware_for_flash")

package(default_visibility = ["//visibility:public"])

exports_files([
    "boot_a53.bif",
    "boot_r5.bif",
])

# ── Step 1: build R5 hello_world with the RPU platform transition ──────────

r5_firmware_for_flash(
    name = "hello_world_rpu_elf",
    elf = "//apps/rpu/hello_world:hello_world",
)

# ── Step 2: convert R5 ELF → flat binary ──────────────────────────────────

genrule(
    name = "hello_world_bin",
    srcs = [":hello_world_rpu_elf"],
    outs = ["hello_world.bin"],
    cmd = "arm-none-eabi-objcopy -O binary $(SRCS) $@",
    local = True,
    tags = [
        "local",
        "manual",
    ],
)

# ── Step 3: embed R5 binary in an AArch64 relocatable object ──────────────
# aarch64-none-elf-objcopy wraps the flat binary into an ELF64 .o that
# exports _binary_hello_world_bin_start/_end for the A53 loader to consume.

genrule(
    name = "hello_world_data_o",
    srcs = [":hello_world_bin"],
    outs = ["hello_world_data.o"],
    # objcopy derives _binary_<name>_start/_end from the input filename.
    # Run from a tmpdir so the symbol is _binary_hello_world_bin_{start,end},
    # matching the extern declarations in board/a53_loader/main.c.
    cmd = "\n".join([
        "tmpdir=$$(mktemp -d)",
        "cp $(SRCS) $$tmpdir/hello_world.bin",
        "(cd $$tmpdir && aarch64-none-elf-objcopy -I binary -O elf64-littleaarch64 -B aarch64 hello_world.bin hello_world_data.o)",
        "cp $$tmpdir/hello_world_data.o $@",
        "rm -rf $$tmpdir",
    ]),
    local = True,
    tags = [
        "local",
        "manual",
    ],
)

# ── Step 4: link A53 loader ELF ───────────────────────────────────────────

genrule(
    name = "a53_loader_elf",
    srcs = [
        "//board/a53_loader:startup.S",
        "//board/a53_loader:main.c",
        "//board/a53_loader:memory.lds",
        ":hello_world_data_o",
    ],
    outs = ["a53_loader.elf"],
    cmd = " ".join([
        "aarch64-none-elf-gcc",
        "-ffreestanding -nostdlib -nostartfiles",
        "-Wl,-T,$(location //board/a53_loader:memory.lds)",
        "-Wl,--gc-sections",
        "-o $@",
        "$(location //board/a53_loader:startup.S)",
        "$(location //board/a53_loader:main.c)",
        "$(location :hello_world_data_o)",
    ]),
    local = True,
    tags = [
        "local",
        "manual",
    ],
)

# ── Step 5: package BOOT.BIN via bootgen ──────────────────────────────────
# Generates a .bif on the fly so the path to a53_loader.elf is always
# correct regardless of the Bazel output directory.
# Requires: bootgen (Xilinx Vitis) in PATH.

genrule(
    name = "boot_bin",
    srcs = [":a53_loader_elf"],
    outs = ["BOOT.BIN"],
    cmd = "\n".join([
        "elf=$$(realpath $(location :a53_loader_elf))",
        "bif=$$(mktemp /tmp/zub_boot_XXXXXX.bif)",
        "echo \"the_ROM_image: { [bootloader, destination_cpu=a53-0] $$elf }\" > $$bif",
        "bootgen -image $$bif -arch zynqmp -o $@ -w on",
        "rm -f $$bif",
    ]),
    local = True,
    tags = [
        "local",
        "manual",
    ],
)

# ── Legacy wrapper script (also handles SD-card copy) ─────────────────────

sh_binary(
    name = "build_boot_a53",
    srcs = ["build_boot_a53.sh"],
    data = [
        "boot_a53.bif",
        "//board/a53_loader:linker_script",
        "//board/a53_loader:sources",
    ],
)

sh_binary(
    name = "xsct_jtag_flash",
    srcs = ["//scripts/xsct:jtag_flash.sh"],
    data = [
        "//board/zub_1cg:bitstream",
        "//board/zub_1cg:psu_init",
    ],
)
