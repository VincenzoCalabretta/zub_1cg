"""OpenOCD interface + boot scripts for the AES-ZUB (Zynq UltraScale+).

Canonical supported entry points (used by integration tests):
  aes_zub.cfg      — FT2232H interface + TAP chain + DAP init sequence.
  psu_init_run.tcl — run Vitis-generated psu_init via OpenOCD (no xsct).
  xsct_shim.tcl    — xsct compatibility shim required by psu_init_run.tcl.
  load_r5.tcl      — full R5 boot sequence: OCM remap, RPU config, UART init,
                     ELF load, R5 release, CoreSight halt-and-run.
  scan_aps.tcl     — safe AP scan; run before adding any cortex_r4 target.

Bring-up diagnostics and lab tools that answer specific hardware questions
live in the adjacent lab/ directory.  Do not include them in test runfiles.
"""

package(default_visibility = ["//visibility:public"])

exports_files([
    "aes_zub.cfg",
    "load_r5.tcl",
    "psu_init_run.tcl",
    "scan_aps.tcl",
    "xsct_shim.tcl",
])

filegroup(
    name = "aes_zub_cfg",
    srcs = ["aes_zub.cfg"],
)

filegroup(
    name = "load_r5",
    srcs = ["load_r5.tcl"],
)

# Canonical scripts for integration tests: interface + psu_init + R5 boot.
filegroup(
    name = "all_scripts",
    srcs = [
        "aes_zub.cfg",
        "load_r5.tcl",
        "psu_init_run.tcl",
        "scan_aps.tcl",
        "xsct_shim.tcl",
    ],
)
